	partition 'Lead List' = m
		mode: import
		source =
				let
				    Source = fnReadCsv("lead_list_top30.csv"),
				    Kept = Table.SelectColumns(Source, {"rank", "district", "bundesland", "segment", "grid_pressure_index", "talking_point", "recommended_approach", "grid_operator"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"rank", Int64.Type}, {"district", type text}, {"bundesland", type text}, {"segment", type text}, {"grid_pressure_index", type number}, {"talking_point", type text}, {"recommended_approach", type text}, {"grid_operator", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
